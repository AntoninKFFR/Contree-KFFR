NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Preferred Supabase secret key.
SUPABASE_SECRET_KEY=

# Legacy fallback only.
SUPABASE_SERVICE_ROLE_KEY=

# Local debug UI only. Keep false or unset in normal deployments.
NEXT_PUBLIC_BOT_REVIEW_MODE=false

# Optional Playwright E2E target. Leave unset to start the local Next.js server.
E2E_BASE_URL=

# Optional existing E2E-only accounts. Never commit real values.
E2E_USER_1_EMAIL=
E2E_USER_1_PASSWORD=
E2E_USER_2_EMAIL=
E2E_USER_2_PASSWORD=
E2E_USER_3_EMAIL=
E2E_USER_3_PASSWORD=
E2E_USER_4_EMAIL=
E2E_USER_4_PASSWORD=
