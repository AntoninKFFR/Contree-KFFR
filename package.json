{
  "name": "coinche-contre-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "simulate:bots": "vite-node --config vitest.config.ts scripts/simulateBots.ts",
    "benchmark:v3": "vite-node --config vitest.config.ts scripts/benchmarkV3.ts",
    "benchmark:bots": "vite-node --config vitest.config.ts scripts/benchmarkBots.ts",
    "benchmark:v3:ablations": "vite-node --config vitest.config.ts scripts/benchmarkV3Ablations.ts",
    "diagnose:bots": "vite-node --config vitest.config.ts scripts/diagnoseBots.ts",
    "diagnose:bidding": "vite-node --config vitest.config.ts scripts/diagnoseBidding.ts",
    "benchmark:bot-components": "vite-node --config vitest.config.ts scripts/benchmarkBotComponents.ts",
    "benchmark:bot-synergy": "vite-node --config vitest.config.ts scripts/benchmarkBotSynergy.ts",
    "benchmark:hybrids": "vite-node --config vitest.config.ts scripts/benchmarkHybrids.ts",
    "benchmark:hybrid-finals": "vite-node --config vitest.config.ts scripts/benchmarkHybridFinals.ts",
    "benchmark:human-doctrine": "vite-node --config vitest.config.ts scripts/benchmarkHumanDoctrine.ts",
    "diagnose:human-doctrine": "vite-node --config vitest.config.ts scripts/diagnoseHumanDoctrineBidding.ts",
    "benchmark:human-doctrine-v2": "vite-node --config vitest.config.ts scripts/benchmarkHumanDoctrineV2.ts",
    "benchmark:human-doctrine-v2-comm": "vite-node --config vitest.config.ts scripts/benchmarkHumanDoctrineV2Comm.ts",
    "diagnose:human-doctrine-v2-initiative": "vite-node --config vitest.config.ts scripts/diagnoseHumanDoctrineV2Initiative.ts",
    "benchmark:human-doctrine-v2-1": "vite-node --config vitest.config.ts scripts/benchmarkHumanDoctrineV21.ts",
    "benchmark:auction-doctrine-v3": "vite-node --config vitest.config.ts scripts/benchmarkAuctionDoctrineV3.ts",
    "benchmark:auction-doctrine-v3-1-smoke": "vite-node --config vitest.config.ts scripts/benchmarkAuctionDoctrineV31Smoke.ts",
    "benchmark:ffb-recalibration": "vite-node --config vitest.config.ts scripts/recalibrateBotsFfb.ts",
    "benchmark:ffb-merge": "vite-node --config vitest.config.ts scripts/mergeFfbScreening.ts",
    "benchmark:advanced-rules": "vite-node --config vitest.config.ts scripts/benchmarkAdvancedRules.ts",
    "test": "vitest run",
    "test:db:social": "node scripts/testSocialDb.mjs",
    "test:db:rating": "node scripts/testRatingDb.mjs && vite-node --config vitest.config.ts scripts/testRatingLifecycleDb.ts && node scripts/testRatingReadDb.mjs",
    "rating:retry": "node scripts/retryPendingRatings.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:multiplayer": "playwright test --project=multiplayer --grep-invert @rating",
    "test:e2e:rating": "playwright test --project=multiplayer --grep @rating",
    "test:e2e:smoke": "playwright test --project=smoke"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^15.3.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.14.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.24.0",
    "eslint-config-next": "15.3.0",
    "jsdom": "^26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vitest": "3.1.1"
  }
}
